                "type": "text/javascript",
                "exec": [
                  "// Ожидание фоновой обработки: повторяем запрос, пока статус не станет финальным для шага",
                  "const want = [\"MANUAL_REVIEW\"];",
                  "const st = pm.response.json().application.status;",
                  "const n = Number(pm.collectionVariables.get('poll') || 0);",
                  "if (!want.includes(st) && n < 40) { pm.collectionVariables.set('poll', n + 1); setTimeout(() => {}, 1000); postman.setNextRequest(pm.info.requestName); }",
                  "else { pm.collectionVariables.set('poll', 0); pm.test('Статус ' + want.join('|'), () => pm.expect(want).to.include(st)); }"
                ]
              }
            }
          ]
