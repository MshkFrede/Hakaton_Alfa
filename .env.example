# Скопируйте в .env и при необходимости измените.
POSTGRES_PASSWORD=credit
JWT_SECRET=change-me-in-production-please
# Пауза между этапами автоматической обработки — чтобы в демо было видно движение заявки по статусам.
PROCESSING_STEP_DELAY=2s
MOCK_LATENCY=400ms

# Порты на хосте (поменяйте, если заняты другими программами)
API_PORT=8080
SWAGGER_PORT=8081
MOCKS_PORT=8090
DB_PORT=5433
